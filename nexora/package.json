{
  "name": "nexora-platform",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@10.4.1",
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "dev:api": "pnpm --filter @nexora/api dev",
    "dev:web": "pnpm --filter @nexora/web dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm --filter @nexora/api test",
    "db:migrate": "pnpm --filter @nexora/api db:migrate",
    "db:seed": "pnpm --filter @nexora/api db:seed",
    "db:reset": "pnpm --filter @nexora/api db:reset",
    "worker": "pnpm --filter @nexora/api worker",
    "format": "prettier --write .",
    "backup": "pnpm --filter @nexora/api backup",
    "backup:verify": "pnpm --filter @nexora/api backup:verify"
  },
  "devDependencies": {
    "prettier": "^3.6.2",
    "typescript": "5.9.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
